# App
API_ENV=dev
CORS_ORIGINS=http://localhost:3000
SECRET_KEY=change-me-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=60
INTERNAL_API_KEY=dev-internal-key-change-in-production

# Database (use docker compose postgres)
DATABASE_URL=postgresql+psycopg://whatcommerce:whatcommerce@127.0.0.1:5433/whatcommerce

# Optional: create first super admin on startup (1 = on)
BOOTSTRAP_ADMIN=1
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe1!

# Paystack (secret key = signing for API + HMAC for webhooks unless PAYSTACK_WEBHOOK_SECRET is set)
# Register webhook URL: https://<your-api>/api/paystack/webhook
# PAYSTACK_SECRET_KEY=sk_test_...
# Optional separate signing secret (defaults to PAYSTACK_SECRET_KEY)
# PAYSTACK_WEBHOOK_SECRET=

# When the API activates a tenant, it POSTs here so the WhatsApp bridge can notify the user
# (must match the bridge DISPATCH_PORT + path; bridge binds 127.0.0.1)
# WHATSAPP_BRIDGE_DISPATCH_URL=http://127.0.0.1:3001/dispatch

# OpenAI (required for store manager on WhatsApp for active subscribers)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# Inbound base64 from bridge (default 5 MB)
# INBOUND_MEDIA_MAX_BYTES=5242880
# Recent turns loaded for the store manager (default 32)
# CONVERSATION_HISTORY_MAX_EVENTS=32
# Knowledge base RAG (search_platform_knowledge)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# KNOWLEDGE_CHUNK_MAX_CHARS=900
# KNOWLEDGE_CHUNK_OVERLAP=120
# KNOWLEDGE_SEARCH_TOP_K=5
# Optional: cap tool+model rounds (default 6)
# STORE_MANAGER_MAX_TOOL_ROUNDS=6

# Serper (optional, future web search in agent)
# SERPER_API_KEY=
