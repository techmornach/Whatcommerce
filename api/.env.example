DATABASE_URL=postgresql+asyncpg://whatcommerce:whatcommerce@localhost:5433/whatcommerce
SERPER_API_KEY=
INTERNAL_API_SECRET=change-me-in-dev

# Dashboard JWT (must match nothing on web — token is issued by API only)
ADMIN_JWT_SECRET=change-admin-jwt-in-dev
# Optional: first super_admin if table is empty (remove after first deploy)
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
# BOOTSTRAP_ADMIN_PASSWORD=choose-a-long-password

# Paystack (https://dashboard.paystack.com/#/settings/developer) — live or test secret
PAYSTACK_SECRET_KEY=

# OpenAI (Agents SDK — platform + store-manager assistants)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Absolute URL for links in WhatsApp (no trailing slash), e.g. https://api.yourdomain.com
PUBLIC_BASE_URL=http://localhost:8000

# Optional: extra CORS origins (comma-separated). Local Next on localhost/127/::1 + any port is allowed by default.
# CORS_ALLOW_ORIGINS=http://192.168.1.10:3000,https://dashboard.example.com

# WhatsApp outbound queue (owner notifications, retries, dead letters)
# WHATSAPP_OUTBOUND_STALE_MINUTES=10
# WHATSAPP_OUTBOUND_MAX_ATTEMPTS=5
