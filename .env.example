# Copy to api/.env and web/.env.local as needed

# PostgreSQL (matches docker-compose defaults)
# Dev: Docker Compose exposes Postgres on 5433 (avoids clashing with a local 5432 install).
DATABASE_URL=postgresql+asyncpg://whatcommerce:whatcommerce@localhost:5433/whatcommerce

# Serper (https://serper.dev) — web search for agents; no Playwright MCP
SERPER_API_KEY=69763a0fc5d7a4cee618f7e4784e763558948789

# WhatsApp workers → API (copy INTERNAL_API_SECRET into each worker’s .env)
#   whatsapp/whatcommerce/.env   — platform bot (landing / onboarding)
#   whatsapp/store-manager/.env — tenant store-manager bot (set TENANT_ID = that shop’s UUID)
INTERNAL_API_SECRET=change-me-in-dev

# Paystack secret (test or live) for initialize + webhook verification
PAYSTACK_SECRET_KEY=

# Next.js: FastAPI origin (landing + admin). Public wa.me uses platform session phone from API only.
NEXT_PUBLIC_API_URL=http://localhost:8000

# API: OpenAI + public link base (see api/.env.example)
# OPENAI_API_KEY=
# PUBLIC_BASE_URL=http://localhost:8000
