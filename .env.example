# Shared secret for bridge <-> API (same value in both services)
INTERNAL_SECRET=change-me-in-dev

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
DEFAULT_TENANT_ID=dev-tenant-1
# URL the API uses to call the bridge (host dev: http://127.0.0.1:3001 ; compose: http://wa-bridge:3001)
BRIDGE_BASE_URL=http://127.0.0.1:3001

# Optional until SQLAlchemy/asyncpg wiring exists (EC2 bootstrap writes this from Secrets Manager)
# DATABASE_URL=postgresql://user:pass@rds-host:5432/whatcommerce

# WhatsApp bridge
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=3001
# URL the bridge uses to POST inbound messages (host dev: http://127.0.0.1:8000 ; compose: http://api:8000)
API_BASE_URL=http://127.0.0.1:8000
# Docker Desktop (bridge on host, API in container): http://host.docker.internal:8000
