#!/bin/bash
set -euo pipefail
exec > >(tee /var/log/whatcommerce-api-bootstrap.log | logger -t whatcommerce-api -s 2>/dev/console) 2>&1

dnf install -y docker jq
systemctl enable --now docker
usermod -aG docker ec2-user || true

INTERNAL="$(aws ssm get-parameter --region "${aws_region}" --name "${internal_param_name}" --with-decryption --query Parameter.Value --output text)"
SECRET_JSON="$(aws secretsmanager get-secret-value --region "${aws_region}" --secret-id "${db_secret_arn}" --query SecretString --output text)"
DB_USER="$(echo "$SECRET_JSON" | jq -r .username)"
DB_PASS="$(echo "$SECRET_JSON" | jq -r .password)"
DB_HOST="$(echo "$SECRET_JSON" | jq -r .host)"
DB_PORT="$(echo "$SECRET_JSON" | jq -r .port)"
DB_NAME="$(echo "$SECRET_JSON" | jq -r .dbname)"
ENC_PASS="$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1], safe=''))" "$DB_PASS")"
DATABASE_URL="postgresql://${DB_USER}:$ENC_PASS@${DB_HOST}:${DB_PORT}/${DB_NAME}"

install -d -m 0750 /etc/whatcommerce
umask 077
cat >/etc/whatcommerce/environment <<EOF
INTERNAL_SECRET=$INTERNAL
BRIDGE_BASE_URL=${bridge_base_url}
DEFAULT_TENANT_ID=${default_tenant_id}
DATABASE_URL=$DATABASE_URL
EOF
chmod 0640 /etc/whatcommerce/environment

echo "Bootstrap complete: /etc/whatcommerce/environment (run your API container with --env-file or systemd EnvironmentFile)."
