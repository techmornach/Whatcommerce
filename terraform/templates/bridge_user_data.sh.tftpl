#!/bin/bash
set -euo pipefail
exec > >(tee /var/log/whatcommerce-bridge-bootstrap.log | logger -t whatcommerce-bridge -s 2>/dev/console) 2>&1

dnf install -y docker
systemctl enable --now docker
usermod -aG docker ec2-user || true

INTERNAL="$(aws ssm get-parameter --region "${aws_region}" --name "${internal_param_name}" --with-decryption --query Parameter.Value --output text)"

install -d -m 0750 /etc/whatcommerce
umask 077
cat >/etc/whatcommerce/environment <<EOF
INTERNAL_SECRET=$INTERNAL
API_BASE_URL=${api_base_url}
DEFAULT_TENANT_ID=${default_tenant_id}
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=3001
EOF
chmod 0640 /etc/whatcommerce/environment

echo "Bootstrap complete: /etc/whatcommerce/environment (run wa-bridge container with --env-file)."
