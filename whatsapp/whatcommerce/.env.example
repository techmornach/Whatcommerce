# FastAPI root only (port 8000), not Next.js (3000), and no /v1 suffix
API_BASE_URL=http://localhost:8000
INTERNAL_API_SECRET=change-me-in-dev

# On `ready`, this worker POSTs session phone to the API; on `qr`, it POSTs pairing data so the admin UI can render the QR.
# Owner notifications (pending orders) are also sent from this platform session.
# OUTBOUND_POLL_MS=20000
# OUTBOUND_ACK_RETRIES=10
# How often the platform worker polls for an admin-requested session wipe / new QR (ms)
# SESSION_RESET_POLL_MS=12000
