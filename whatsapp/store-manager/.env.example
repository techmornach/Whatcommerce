# FastAPI root only (no /v1 suffix), not the Next.js URL
API_BASE_URL=http://localhost:8000
INTERNAL_API_SECRET=change-me-in-dev

# Required: UUID of the tenant this WhatsApp session serves (from GET /v1/internal/tenants or DB).
# Each store runs its own worker + own .env — different TENANT_ID ⇒ no cross-store clashes.
TENANT_ID=

# Optional: UUID from the post-payment WhatsApp link (?token=…). Required while that link is still valid
# so the API can verify this session matches the Paystack checkout flow.
# WA_LINK_TOKEN=

# Optional: poll for store_manager-channel outbounds (rare). Owner order pings use the whatcommerce worker.
# OUTBOUND_POLL_MS=20000
# OUTBOUND_ACK_RETRIES=10
