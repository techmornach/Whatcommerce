#!/bin/bash
set -euo pipefail

dnf update -y
dnf install -y python3 python3-pip python3.12 git awscli

mkdir -p /opt/whatcommerce

APP_VENV="/opt/whatcommerce/.venv"
API_PYTHON="$APP_VENV/bin/python"
PYTHON_BIN="/usr/bin/python3.12"
UV_BIN=""
BOOTSTRAP_MODE="${bootstrap_mode}"
API_PORT="${api_port}"
AWS_REGION="${aws_region}"
API_ENV_SECRET_ARN="${api_env_secret_arn}"
APP_DIR="/opt/whatcommerce"
APP_IMPORT="health_app:app"

if [ ! -x "$PYTHON_BIN" ]; then
  PYTHON_BIN="/usr/bin/python3"
fi

install_stub_app() {
cat > /opt/whatcommerce/health_app.py <<'PYEOF'
from fastapi import FastAPI
from fastapi.responses import JSONResponse

app = FastAPI(title="whatcommerce-api-bootstrap")

@app.get("/health")
def health():
    return JSONResponse({"status": "ok", "service": "api-bootstrap"})

@app.get("/")
def root():
    return JSONResponse({"message": "whatcommerce api bootstrap running"})
PYEOF
}

if command -v uv >/dev/null 2>&1; then
  UV_BIN="$(command -v uv)"
else
  if curl -LsSf https://astral.sh/uv/install.sh | sh; then
    if [ -x "/root/.local/bin/uv" ]; then
      UV_BIN="/root/.local/bin/uv"
    elif command -v uv >/dev/null 2>&1; then
      UV_BIN="$(command -v uv)"
    fi
  fi
fi

if [ -n "$UV_BIN" ]; then
  "$UV_BIN" venv "$APP_VENV" --python "$PYTHON_BIN"
  "$UV_BIN" pip install --python "$API_PYTHON" "fastapi>=0.110,<1.0" "uvicorn[standard]>=0.28,<1.0"
else
  # Fallback path when uv bootstrap is unavailable.
  "$PYTHON_BIN" -m ensurepip --upgrade || true
  "$PYTHON_BIN" -m pip install "fastapi>=0.110,<1.0" "uvicorn[standard]>=0.28,<1.0" || true
  API_PYTHON="$PYTHON_BIN"
fi

if [ "$BOOTSTRAP_MODE" = "real" ]; then
  REPO_URL="${api_repo_url}"
  REPO_REF="${api_repo_ref}"
  APP_SUBDIR="${api_app_subdir}"
  APP_IMPORT="${api_uvicorn_app}"
  mkdir -p /opt/whatcommerce
  rm -rf /opt/whatcommerce/src

  if [ -n "$REPO_URL" ]; then
    if git clone --depth 1 --branch "$REPO_REF" "$REPO_URL" /opt/whatcommerce/src; then
      APP_DIR="/opt/whatcommerce/src/$APP_SUBDIR"
      if [ ! -d "$APP_DIR" ]; then
        APP_DIR="/opt/whatcommerce/src"
      fi

      if [ -f "$APP_DIR/pyproject.toml" ]; then
        if [ -n "$UV_BIN" ]; then
          if ! "$UV_BIN" pip install --python "$API_PYTHON" "$APP_DIR"; then
            BOOTSTRAP_MODE="stub"
          fi
        elif ! "$API_PYTHON" -m pip install "$APP_DIR"; then
          BOOTSTRAP_MODE="stub"
        fi
      elif [ -f "$APP_DIR/requirements.txt" ]; then
        if [ -n "$UV_BIN" ]; then
          if ! "$UV_BIN" pip install --python "$API_PYTHON" -r "$APP_DIR/requirements.txt"; then
            BOOTSTRAP_MODE="stub"
          fi
        elif ! "$API_PYTHON" -m pip install -r "$APP_DIR/requirements.txt"; then
          BOOTSTRAP_MODE="stub"
        fi
      fi

      if [ "$BOOTSTRAP_MODE" = "real" ] && [ -n "$API_ENV_SECRET_ARN" ]; then
        aws secretsmanager get-secret-value \
          --secret-id "$API_ENV_SECRET_ARN" \
          --region "$AWS_REGION" \
          --query SecretString \
          --output text > "$APP_DIR/.env"
      fi

      if [ "$BOOTSTRAP_MODE" = "real" ] && [ -f "$APP_DIR/alembic.ini" ]; then
        if ! (cd "$APP_DIR" && "$API_PYTHON" -m alembic upgrade heads); then
          BOOTSTRAP_MODE="stub"
        fi
      fi
    else
      BOOTSTRAP_MODE="stub"
    fi
  else
    BOOTSTRAP_MODE="stub"
  fi
fi

if [ "$BOOTSTRAP_MODE" = "stub" ]; then
  install_stub_app
  APP_DIR="/opt/whatcommerce"
  APP_IMPORT="health_app:app"
fi

cat > /etc/systemd/system/whatcommerce-api.service <<UNITEOF
[Unit]
Description=Whatcommerce API bootstrap service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=$${APP_DIR}
ExecStart=$${API_PYTHON} -m uvicorn $${APP_IMPORT} --host 0.0.0.0 --port $${API_PORT}
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
UNITEOF

systemctl daemon-reload
systemctl enable whatcommerce-api.service
systemctl restart whatcommerce-api.service

sleep 10
if ! systemctl is-active --quiet whatcommerce-api.service; then
  install_stub_app
  cat > /etc/systemd/system/whatcommerce-api.service <<UNITEOF
[Unit]
Description=Whatcommerce API fallback health service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/whatcommerce
ExecStart=$${API_PYTHON} -m uvicorn health_app:app --host 0.0.0.0 --port $${API_PORT}
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
UNITEOF
  systemctl daemon-reload
  systemctl restart whatcommerce-api.service
fi
